    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "tsx": "^4.0.0",
    "vitest": "^4.0.0",
    "supertest": "^7.0.0"
