{
  "name": "@worksphere/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "initialize:rbac": "tsx src/scripts/initialize-rbac.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "reset:admin-password": "tsx src/scripts/reset-admin-password.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
